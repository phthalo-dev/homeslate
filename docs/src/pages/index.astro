---
import DocsMarketingPage from '@var-ui/docs/DocsMarketingPage';
import { defaultThemeClassName } from '@var-ui/core';
import { Card, Heading, Link, Stack, Text } from '@var-ui/astro';
import { brand, loadDocsNavigation, topNav } from '../data/navigation';

const { searchItems } = await loadDocsNavigation();
---

<DocsMarketingPage
  title="Homeslate"
  themeClassName={defaultThemeClassName}
  topNav={topNav}
  searchItems={searchItems}
  brand={brand}
>
  <Stack gap="xl" style="max-width: 44rem; margin-inline: auto; padding-block: 3rem 4rem;">
    <Stack gap="sm">
      <Heading level={1} size="xl">Homeslate</Heading>
      <Text tone="secondary">
        MIT packages and a clone-and-run host for a household command center.
      </Text>
    </Stack>

    <Stack gap="md">
      <Card
        href="/docs/getting-started"
        title="Run it"
        description="Clone the repo, install, and start the reference editor and kiosk."
      />
      <Card
        href="/docs/packages"
        title="Embed the packages"
        description="Host contract and usage for every published @homeslate/* package."
      />
      <Card
        href="/docs/api"
        title="Read the API"
        description="Generated signatures for each public entry point."
      />
    </Stack>

    <Text size="sm" tone="secondary">
      The managed hosted product lives in the private
      <Link href="https://github.com/phthalo-dev/homeslate-hosted">homeslate-hosted</Link> repository.
    </Text>
  </Stack>
</DocsMarketingPage>

<script>
  import '../../typestyles-entry.ts';
</script>
